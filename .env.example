# 复制这个文件为 .env，然后填真实值（Supabase 项目建好后，Project Settings > API 里能找到）
# 只填 Project URL 和 anon key。service_role key 绝不放这里，也绝不放前端代码。

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push（推送通知）用的 VAPID 密钥对，`npx web-push generate-vapid-keys --json` 生成。
# 只有公钥（VITE_ 开头）会被打进前端代码，私钥和下面的共享密码绝不能加 VITE_ 前缀，
# 也不会被打进前端 —— 它们只用在 Supabase Edge Function 那边（见 README「Web Push」一节）。
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CRON_SECRET=
PUSH_CONTACT_EMAIL=
